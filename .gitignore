# Local credentials and environment overrides
.env
.env.*
!.env.example
.nev

# Local Google/service-account credentials must never be committed.
*-service-account*.json
service-account*.json
google-credentials*.json

# Dependencies and package-manager state
node_modules/
.pnpm-store/
.pnp.*

# Build output and tool caches
dist/
coverage/
.vite/
.turbo/
.eslintcache
*.tsbuildinfo

# Test reports and temporary artifacts
playwright-report/
test-results/
blob-report/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and operating-system files
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
